<Window x:Class="work.Pages.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel"
        Height="355" Width="563"
        WindowStartupLocation="CenterScreen"
        Background="#D9D9D9"
        >

    <Window.Resources>
        <Style x:Key="AdminTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="103"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9C9C9C"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#A2A2A2" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Icons/administrator.png" Width="24" Height="24"/>
                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                        <TextBlock Text="Admin" Style="{StaticResource AdminTextStyle}"/>
                        <TextBlock x:Name="EmailTextBlock" Text="admin@example.com" Style="{StaticResource AdminTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Click="BackButton_Click"
                            Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/back-button.png" Width="16" Height="16"/>
                    </Button>
                    <Button Click="LogoutButton_Click"
                            Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/logout.png" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Width="509" Height="186"
        CornerRadius="5"
        Background="#A2A2A2"
        BorderBrush="#9C9C9C"
        BorderThickness="1"
        Margin="0,10,0,10"
        Padding="2">
                <DataGrid x:Name="TransactionsDataGrid"
              Background="#A2A2A2"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              BorderThickness="0"
              RowBackground="#A2A2A2"
              AlternatingRowBackground="#B5B5B5"
              Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}" />
                        <DataGridTextColumn Header="Date/Time" Binding="{Binding DataTime}" />
                        <DataGridTextColumn Header="Quantity (L)" Binding="{Binding QuantityLiters}" />
                        <DataGridTextColumn Header="Money" Binding="{Binding Money}" />
                        <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" />
                        <DataGridTextColumn Header="Station ID" Binding="{Binding StationId}" />
                        <DataGridTextColumn Header="Pump ID" Binding="{Binding PumpId}" />

                    </DataGrid.Columns>
                </DataGrid>
            </Border>



            <!-- Sort Options and Button -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sort Text and Radio Buttons -->
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByTransactionId" Content="Transaction ID" Tag="TransactionId" GroupName="SortColumn" IsChecked="True" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByDataTime" Content="Date/Time" Tag="DataTime" GroupName="SortColumn" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByQuantityLiters" Content="Quantity (L)" Tag="QuantityLiters" GroupName="SortColumn" Margin="0,0,8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SortByMoney" Content="Money" Tag="Money" GroupName="SortColumn" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByFuelType" Content="Fuel Type" Tag="FuelType" GroupName="SortColumn" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByStationId" Content="Station ID" Tag="StationId" GroupName="SortColumn" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SortByPumpId" Content="Pump ID" Tag="PumpId" GroupName="SortColumn"/>
                </StackPanel>

                <!-- Sort Button -->
                <Button Grid.Column="1"
            Grid.RowSpan="2"
            Content="Sort"
            Style="{StaticResource RoundedButtonStyle}"
            Background="#36A2D0"
            VerticalAlignment="Center"
            Margin="10,0,0,0"
            Click="SortButton_Click"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
