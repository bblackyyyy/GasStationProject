<Window x:Class="work.Pages.EditFuelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Fuel Window" Height="355" Width="563"
        Background="#D9D9D9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="AdminTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#7F7D7D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nav Bar -->
        <Border Grid.Row="0" Background="#A2A2A2" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Icons/administrator.png" Width="24" Height="24"/>
                    <StackPanel Orientation="Vertical" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Admin" Style="{StaticResource AdminTextStyle}"/>
                        <TextBlock x:Name="EmailTextBlock" Text="admin@example.com" Style="{StaticResource AdminTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BackButton_Click" Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/back-button.png" Width="16" Height="16"/>
                    </Button>
                    <Button Click="LogoutButton_Click" Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/logout.png" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Content -->
        <Grid Grid.Row="1">
            <Border Width="235" Height="235" Background="#A2A2A2" CornerRadius="5"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="15">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    

                    <!-- Price Input -->
                    <Grid Width="170" Height="28" Margin="0,0,0,10">
                        <TextBox x:Name="PriceTextBox" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="PriceTextBox_TextChanged"/>
                        <TextBlock x:Name="PricePlaceholder"
                                   Text="Price"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   Foreground="White"
                                   Background="Transparent"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Tax Input -->
                    <Grid Width="170" Height="28" Margin="0,0,0,10">
                        <TextBox x:Name="TaxTextBox" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="TaxTextBox_TextChanged"/>
                        <TextBlock x:Name="TaxPlaceholder"
                                   Text="Tax"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   Foreground="White"
                                   Background="Transparent"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Add Button -->
                    <Button Content="Save"
                            Background="#36A2D0"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="AddButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
