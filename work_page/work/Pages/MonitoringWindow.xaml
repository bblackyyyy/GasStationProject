<Window x:Class="work.Pages.MonitoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel"
        Height="355" Width="563"
        WindowStartupLocation="CenterScreen"
        Background="#D9D9D9"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="AdminTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="103"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9C9C9C"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#A2A2A2" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Icons/administrator.png" Width="24" Height="24"/>
                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                        <TextBlock Text="Admin" Style="{StaticResource AdminTextStyle}"/>
                        <TextBlock x:Name="EmailTextBlock" Text="admin@example.com" Style="{StaticResource AdminTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Click="BackButton_Click"
                            Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/back-button.png" Width="16" Height="16"/>
                    </Button>
                    <Button Click="LogoutButton_Click"
                            Style="{StaticResource IconButtonStyle}">
                        <Image Source="Icons/logout.png" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Width="509" Height="186"
        CornerRadius="5"
        Background="#A2A2A2"
        BorderBrush="#9C9C9C"
        BorderThickness="1"
        Margin="0,10,0,10"
        Padding="2">
                <DataGrid x:Name="MonitoringDataGrid"
              Background="#A2A2A2"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              BorderThickness="0"
              RowBackground="#A2A2A2"
              AlternatingRowBackground="#B5B5B5"
              Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Station Id" Binding="{Binding StationId}" Width="*" />
                        <DataGridTextColumn Header="Pump Id" Binding="{Binding PumpId}" Width="*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                        <DataGridTextColumn Header="Income" Binding="{Binding Income}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                        <DataGridTemplateColumn Header="Select" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="FuelSelectGroup" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,10,0,0">
                <Button Content="Details"
            Style="{StaticResource RoundedButtonStyle}"
            Background="#36A2D0"
            Margin="0,0,10,0"
            Click="DetailButton_Click"/>
                <Button Content="Report"
            Style="{StaticResource RoundedButtonStyle}"
            Background="#47D23D"
            Click="ReportButton_Click"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>
